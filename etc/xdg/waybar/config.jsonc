{
    "layer": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": [
    	"clock"
    ],

    "modules-center": [],

    "modules-right": [
    	"battery"
    	//, "tray"
    ],
    
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "tray": {
        "spacing": 6
    },

    "clock": {
        "format": "{:%d%m%y %H%M}"
    },

    "battery": {
        "format": "{capacity}%"
    }
}
