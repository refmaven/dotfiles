configuration {
font: "monospace 13";
}

* {
  bg: #000000;
  fg: #ffffff;
  fg-muted: #aaaaaa;
  selected-bg: #ffffff;
  selected-fg: #000000;
  border: 0px;
  border-color: #000000;
  }

window {
    width: 35%;
    height: 45%;
    background-color: #000000;
    border: 1px;
    border-color: #252525;
    border-radius: 0px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    border: 0px;
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    background-color: #000000;
    border: 1px;
    border-color: #202020;
    border-radius: 0px;
    padding: 8px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
background-color: transparent;
border: 0px;
text-color: #ffffff;
}

entry {
background-color: transparent;
border: 0px;
text-color: #ffffff;
placeholder: "search";
placeholder-color: #aaaaaa;
}

listview {
background-color: transparent;
border: 0px;
columns: 1;
lines: 8;
spacing: 2px;
scrollbar: false;
}

element {
background-color: transparent;
border: 0px;
text-color: #ffffff;
padding: 0px;
margin: 0px;
}

element-text {
background-color: transparent;
text-color: inherit;
}

element-icon {
background-color: transparent;
size: 24px;
}

element normal {
background-color: transparent;
text-color: #ffffff;
}

element normal element-text {
background-color: transparent;
text-color: #ffffff;
}

element normal element-icon {
background-color: transparent;
}

element alternate {
background-color: transparent;
text-color: #ffffff;
}

element alternate element-text {
background-color: transparent;
text-color: #ffffff;
}

element alternate element-icon {
background-color: transparent;
}

element selected {
background-color: #ffffff;
text-color: #000000;
}

element selected element-text {
background-color: transparent;
text-color: #000000;
}

element selected element-icon {
background-color: transparent;
}

element urgent {
background-color: transparent;
text-color: #ffffff;
}

element urgent element-text {
background-color: transparent;
text-color: #ffffff;
}

element urgent element-icon {
background-color: transparent;
}

scrollbar {
background-color: transparent;
border: 0px;
handle-color: #ffffff;
handle-width: 0px;
}

message {
background-color: transparent;
border: 0px;
text-color: #aaaaaa;
}

textbox {
background-color: transparent;
border: 0px;
text-color: #ffffff;
}

/* unselected items */
element normal,
element alternate {
background-color: transparent;
text-color: #ffffff;
}

/* selected item */
element selected,
element selected.normal,
element selected.active,
element selected.urgent {
background-color: #ffffff;
text-color: #000000;
}

/* selected text */
element selected element-text,
element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
background-color: transparent;
text-color: #000000;
}

/* row contents inherit their parent row's colors */
element-text,
element-icon {
background-color: transparent;
text-color: inherit;
}

/* unselected rows */
element.normal.normal,
element.alternate.normal,
element.normal.active,
element.alternate.active,
element.normal.urgent,
element.alternate.urgent {
background-color: transparent;
text-color: #ffffff;
}

/* selected rows */
element.selected.normal,
element.selected.active,
element.selected.urgent {
background-color: #ffffff;
text-color: #000000;
}
