configuration {
    font: "JetBrainsMono Nerd Font Mono 11.25";
}

* {
    bg: #000000;
    fg: #ffffff;
    fg-muted: #aaaaaa;
    selected-bg: #ffffff;
    selected-fg: #000000;
    border: 0px;
    border-color: #000000;
}

window {
    width: 35%;
    height: 45%;
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    padding: 0;
}

mainbox {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

entry {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
    placeholder: "search";
    placeholder-color: #aaaaaa;
}

listview {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    columns: 1;
    lines: 8;
    spacing: 2px;
    scrollbar: false;
}

element {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
    padding: 0px;
    margin: 0;
}

element-text {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element-icon {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    size: 24px;
}

element normal {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element normal element-text {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element normal element-icon {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
}

element alternate {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element alternate element-text {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element alternate element-icon {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
}

element selected {
    background-color: #ffffff;
    text-color: #000000;
}

element selected element-text {
    background-color: #ffffff;
    text-color: #000000;
}

element selected element-icon {
    background-color: #ffffff;
}

element urgent {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element urgent element-text {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

element urgent element-icon {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
}

scrollbar {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    handle-color: #ffffff;
    handle-width: 0px;
}

message {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #aaaaaa;
}

textbox {
    background-color: #000000;
    border: 0px;
    border-color: #000000;
    text-color: #ffffff;
}

/* Unselected items */
element normal {
    background-color: #000000;
    text-color: #ffffff;
}
element alternate {
    background-color: #000000;
    text-color: #ffffff;
}

/* Selected item only */
element selected {
    background-color: #ffffff;
    text-color: #000000;
}
element selected.normal {
    background-color: #ffffff;
    text-color: #000000;
}
element selected.active {
    background-color: #ffffff;
    text-color: #000000;
}
element selected.urgent {
    background-color: #ffffff;
    text-color: #000000;
}

/* Selected text */
element selected element-text {
    background-color: #ffffff;
    text-color: #000000;
}
element selected.normal element-text {
    background-color: #ffffff;
    text-color: #000000;
}
element selected.active element-text {
    background-color: #ffffff;
    text-color: #000000;
}
element selected.urgent element-text {
    background-color: #ffffff;
    text-color: #000000;
}


/* Row contents follow their parent row colors */
element-text,
element-icon {
    background-color: inherit;
    text-color: inherit;
}

/* All unselected rows stay black with white text */
element.normal.normal,
element.alternate.normal,
element.normal.active,
element.alternate.active,
element.normal.urgent,
element.alternate.urgent {
    background-color: #000000;
    text-color: #ffffff;
}

/* Only the selected row becomes white with black text */
element.selected.normal,
element.selected.active,
element.selected.urgent {
    background-color: #ffffff;
    text-color: #000000;
}
